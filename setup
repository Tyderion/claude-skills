#!/usr/bin/env bash
# Install this repo's skills into Claude Code and the commands they need.
# Bash on purpose: it runs on a fresh machine before bun exists, and it stays
# within bash 3.2 (macOS's /bin/bash): no associative arrays, no mapfile, no set -u.
set -eo pipefail

usage() {
  cat <<'EOF'
Usage: ./setup [--prefix | --no-prefix] [--yes] [--force] [<skill>...]

Copies skills/<name>/ to ~/.claude/skills/[_]<name>/ (CLAUDE_CONFIG_DIR moves
~/.claude), fills in {{SKILL_NAME}}, {{SKILL_DIR}} and {{SOURCE_DIR}}, writes a
bun shim to ~/.local/bin (XDG_BIN_HOME moves it) for each `bin` entry, and makes
sure the commands every skill's install.conf asks for are there.

  --prefix      install as _<name> (the default when ~/.claude/LIFEOS exists)
  --no-prefix   install as <name>
  --yes         install missing packages without asking
  --force       replace installed copies edited in place, and files setup did
                not write; they are moved to a backup folder, never deleted

Missing commands come from pacman on Arch-family Linux and from Homebrew on
macOS. Anywhere else, or for anything those can't provide, setup prints a
prompt to paste into Claude Code and exits 2. Rerun after every pull.
EOF
}

REPO=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) # CDPATH could send cd elsewhere
CLAUDE_DIR=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
BIN_DIR=${XDG_BIN_HOME:-$HOME/.local/bin}
BACKUP_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/claude-skills/backup
OS_RELEASE=${SETUP_OS_RELEASE:-/etc/os-release} # tests point these two at fakes
KERNEL=${SETUP_UNAME:-$(uname -s)}
. "$OS_RELEASE" 2>/dev/null || true # ID, ID_LIKE, PRETTY_NAME; absent on macOS
MARKER=.skill-install
SHIM_TAG="# installed by claude-skills setup"

say() { printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die() { printf 'setup: %s\n' "$*" >&2; exit 1; }
tilde() { case $1 in "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;; *) printf '%s' "$1" ;; esac; }

prefix=""
if [ -d "$CLAUDE_DIR/LIFEOS" ]; then prefix=_; fi
yes=0 force=0 skills=()
while [ $# -gt 0 ]; do
  case $1 in
    --prefix) prefix=_ ;;
    --no-prefix) prefix= ;;
    -y|--yes) yes=1 ;;
    --force) force=1 ;;
    -h|--help) usage; exit 0 ;;
    -*) usage >&2; die "unknown option $1" ;;
    *) s=$1 # tab completion leaves a trailing slash
       while case $s in */) true ;; *) false ;; esac; do s=${s%/}; done
       case $s in */*|'') die "not a skill name: $1 (use the folder name under skills/)" ;; esac
       [ -f "$REPO/skills/$s/SKILL.md" ] || die "no skill named $s in $REPO/skills"
       skills+=("$s") ;;
  esac
  shift
done
if [ ${#skills[@]} -eq 0 ]; then
  for d in "$REPO"/skills/*/; do [ -f "$d/SKILL.md" ] && skills+=("$(basename "$d")"); done
fi
[ ${#skills[@]} -gt 0 ] || die "no skills found in $REPO/skills"

# install.conf lines without comments or blank lines. A comment needs a space before its #.
# `awk 1` ends the last line with a newline, which `read` needs to see it.
conf() {
  local f="$REPO/skills/$1/install.conf"
  if [ -f "$f" ]; then sed -e 's/[[:space:]]#.*$//' -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$f" | awk 1; fi
}

# ---------------------------------------------------------------- dependencies

# Package manager for this machine: pacman (Arch family), brew (macOS), or empty.
manager() {
  if [ "$KERNEL" = Darwin ]; then
    if command -v brew >/dev/null 2>&1; then echo brew; fi
  else
    case " $ID $ID_LIKE " in
      *" arch "*) if command -v pacman >/dev/null 2>&1; then echo pacman; fi ;;
    esac
  fi
}

# Is dotted version $1 at least $2?
ver_ge() {
  local IFS=. i x y
  local -a a b
  a=($1) b=($2)
  for i in 0 1 2 3; do
    x=${a[i]:-0} y=${b[i]:-0}
    if ((10#$x > 10#$y)); then return 0; fi
    if ((10#$x < 10#$y)); then return 1; fi
  done
}
version_of() { "$1" --version 2>/dev/null | grep -oE '[0-9]+(\.[0-9]+)+' | head -n1 || true; }

# Every dependency once, across all skills: parallel arrays, since bash 3.2 has no maps.
# A command any skill requires is required; the highest minimum version wins.
d_cmd=() d_req=() d_min=() d_arch=() d_brew=() d_why=() d_have=()
add_dep() { # kind cmd min arch brew why
  local i=0
  while [ $i -lt ${#d_cmd[@]} ]; do
    if [ "${d_cmd[i]}" = "$2" ]; then
      if [ "$1" = require ]; then d_req[i]=1; fi
      if [ "$3" != - ] && { [ "${d_min[i]}" = - ] || ! ver_ge "${d_min[i]}" "$3"; }; then d_min[i]=$3; fi
      if [ -z "${d_arch[i]}" ]; then d_arch[i]=$4; fi
      if [ -z "${d_brew[i]}" ]; then d_brew[i]=$5; fi
      return
    fi
    i=$((i + 1))
  done
  d_cmd+=("$2"); d_min+=("$3"); d_arch+=("$4"); d_brew+=("$5"); d_why+=("$6")
  if [ "$1" = require ]; then d_req+=(1); else d_req+=(0); fi
}

for s in "${skills[@]}"; do
  while read -r kind rest; do
    case $kind in
      require|optional)
        set -f; set -- $rest; set +f # split on spaces, but never expand * or ? against the cwd
        [ $# -ge 2 ] || die "skills/$s/install.conf: '$kind $rest' needs <command> <min version|->"
        cmd=$1 min=$2 arch= brew= why=
        shift 2
        while [ $# -gt 0 ]; do
          case $1 in
            arch=*) arch=${1#arch=} ;;
            brew=*) brew=${1#brew=} ;;
            --) shift; why=$*; break ;;
            *) die "skills/$s/install.conf: unexpected '$1' in: $kind $rest" ;;
          esac
          shift
        done
        add_dep "$kind" "$cmd" "$min" "$arch" "$brew" "$why"
        ;;
      bin) ;;
      *) die "skills/$s/install.conf: unknown entry '$kind'" ;;
    esac
  done < <(conf "$s")
done

# Indexes of dependencies that are absent or too old, in `missing`; what was found, in `d_have`.
check_deps() {
  missing=()
  local i=0 have
  while [ $i -lt ${#d_cmd[@]} ]; do
    if ! command -v "${d_cmd[i]}" >/dev/null 2>&1; then
      missing+=($i) d_have[i]=none
    elif [ "${d_min[i]}" != - ]; then
      have=$(version_of "${d_cmd[i]}")
      d_have[i]="${have:-unknown version} at $(command -v "${d_cmd[i]}")"
      if [ -z "$have" ] || ! ver_ge "$have" "${d_min[i]}"; then missing+=($i); fi
    fi
    i=$((i + 1))
  done
}

describe_dep() { # missing index -> "bun >= 1.1 (required; found: 1.0.3 at /usr/bin/bun)"
  local i=$1 what=required
  if [ "${d_req[i]}" = 0 ]; then what="optional, for ${d_why[i]}"; fi
  printf '%s' "${d_cmd[i]}"
  if [ "${d_min[i]}" != - ]; then printf ' >= %s' "${d_min[i]}"; fi
  printf ' (%s; found: %s)' "$what" "${d_have[i]}"
}

check_deps
mgr=$(manager)
pm_ran=0
if [ ${#missing[@]} -gt 0 ] && [ -n "$mgr" ]; then
  pkgs=()
  for i in "${missing[@]}"; do
    if [ "$mgr" = pacman ]; then p=${d_arch[i]}; else p=${d_brew[i]}; fi
    if [ -n "$p" ]; then pkgs+=("$p"); fi
  done
  if [ ${#pkgs[@]} -gt 0 ]; then
    if [ "$mgr" = pacman ]; then
      run=(pacman -S --needed "${pkgs[@]}")
      if [ "$(id -u)" != 0 ]; then run=(sudo "${run[@]}"); fi
    else
      run=(brew install "${pkgs[@]}")
    fi
    say "missing:"
    for i in "${missing[@]}"; do say "  $(describe_dep "$i")"; done
    go=$yes asked=0
    if [ $go = 0 ] && [ -t 0 ]; then
      printf 'run: %s ? [Y/n] ' "${run[*]}"
      read -r answer || answer=n
      asked=1
      case $answer in ''|y|Y|yes) go=1 ;; esac
    fi
    if [ $go = 1 ]; then
      say "running: ${run[*]}"
      "${run[@]}" || warn "${run[0]} failed; see above"
      pm_ran=1
      hash -r
      check_deps
    else
      if [ $asked = 1 ]; then say "skipped; run this yourself, or rerun with --yes:"
      else say "not installing anything without a terminal to ask in; run this yourself, or rerun with --yes:"; fi
      say "  ${run[*]}"
    fi
  fi
fi

# ---------------------------------------------------------------- skills

sha256() { if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi | cut -d' ' -f1; }
# Content hash of a directory: each file's path, executable bit and bytes, and each symlink's
# target, so a chmod +x or a retargeted link counts as a change. The marker is left out, and
# so is macOS metadata (Finder drops .DS_Store into any folder it opens).
hash_tree() {
  (CDPATH= cd -- "$1" && find . \( -type f -o -type l \) ! -name "$MARKER" ! -name .DS_Store ! -name '._*' | LC_ALL=C sort \
    | while IFS= read -r f; do
        if [ -L "$f" ]; then printf 'L %s -> %s\n' "$f" "$(readlink "$f")"
        else printf 'F %s %s\n' "$f" "$([ -x "$f" ] && echo x)"; cat "$f"; fi
      done) | sha256
}
marker_get() { sed -n "s/^$2=//p" "$1/$MARKER" 2>/dev/null || true; }
# rm -rf that also works on copied read-only folders (cp -R keeps their mode).
rmtree() { chmod -R u+w "$1" 2>/dev/null || true; rm -rf "$1"; }

# Put $1 out of the way: our own unedited copy is deleted (the repo can rebuild it),
# anything else needs --force and is moved to the backup folder.
clear_path() {
  local path=$1 why=$2 dest
  if [ -z "$why" ]; then rmtree "$path"; return; fi
  [ $force = 1 ] || die "$why
rerun with --force to move it to $(tilde "$BACKUP_DIR") and continue"
  mkdir -p "$BACKUP_DIR"
  # A fresh folder per backup: two in the same second must never land on each other.
  dest=$(mktemp -d "$BACKUP_DIR/$(basename "$path").$(date +%Y%m%d-%H%M%S).XXXXXX")
  mv "$path" "$dest/"
  say "backed up $(tilde "$path") to $(tilde "$dest/$(basename "$path")")"
}

# Why an existing skill folder may not simply be replaced, or nothing if it may.
blocker() {
  local dir=$1
  if [ ! -f "$dir/$MARKER" ]; then
    echo "$(tilde "$dir") was not installed by this setup"
  elif [ "$(hash_tree "$dir")" != "$(marker_get "$dir" hash)" ]; then
    echo "$(tilde "$dir") was edited after setup installed it; carry the edit over to $(tilde "$(marker_get "$dir" source)") (compare: diff -r $(tilde "$(marker_get "$dir" source)") $(tilde "$dir"))"
  fi
}

# sed replacement text: escape \, | and &.
sed_text() { printf '%s' "$1" | sed -e 's/[\\|&]/\\&/g'; }

commit=$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo none)
mkdir -p "$CLAUDE_DIR/skills"
tmp=
trap '[ -n "$tmp" ] && [ -d "$tmp" ] && rmtree "$tmp"' EXIT # harmless once tmp has been moved into place
for s in "${skills[@]}"; do
  src="$REPO/skills/$s"
  name=$prefix$s
  dest="$CLAUDE_DIR/skills/$name"
  if [ -z "$prefix" ]; then other="$CLAUDE_DIR/skills/_$s"; else other="$CLAUDE_DIR/skills/$s"; fi
  state=$commit
  if [ -n "$(git -C "$REPO" status --porcelain -- "skills/$s" 2>/dev/null)" ]; then state="$commit+uncommitted"; fi

  # Build next to the target (same filesystem, so the final mv is a rename), outside skills/.
  tmp=$(mktemp -d "$CLAUDE_DIR/.skill-setup.XXXXXX")
  cp -R "$src/." "$tmp/"
  rm -f "$tmp/install.conf"
  find "$tmp" -type f \( -name .DS_Store -o -name '._*' \) -exec rm -f {} +
  e_name=$(sed_text "$name") e_dir=$(sed_text "$(tilde "$dest")") e_src=$(sed_text "$(tilde "$src")")
  # Listed first and looped in this shell, so a failure stops setup instead of vanishing in a pipe.
  # LC_ALL=C: macOS sed rejects bytes that aren't valid UTF-8 otherwise.
  files=$(grep -rlF '{{' "$tmp" || true)
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    LC_ALL=C sed -e "s|{{SKILL_NAME}}|$e_name|g" -e "s|{{SKILL_DIR}}|$e_dir|g" -e "s|{{SOURCE_DIR}}|$e_src|g" "$f" > "$f.setup" \
      || die "cannot fill placeholders in ${f#"$tmp"/} (skills/$s); nothing installed for it"
    cat "$f.setup" > "$f" || die "cannot write ${f#"$tmp"/} (skills/$s); nothing installed for it" # cat keeps the mode
    rm "$f.setup"
  done <<EOF
$files
EOF
  hash=$(hash_tree "$tmp")
  printf 'source=%s\ncommit=%s\nhash=%s\n' "$src" "$state" "$hash" > "$tmp/$MARKER"

  why=
  present=0 # a dangling symlink counts too: it is something in the way
  if [ -e "$dest" ] || [ -L "$dest" ]; then present=1 why=$(blocker "$dest"); fi
  if [ $present = 1 ] && [ -z "$why" ] && [ "$(marker_get "$dest" hash)" = "$hash" ] && [ "$(marker_get "$dest" source)" = "$src" ]; then
    mv "$tmp/$MARKER" "$dest/$MARKER" # same content; record the current commit
    rmtree "$tmp"
    say "unchanged  $(tilde "$dest")"
  else
    if [ $present = 1 ]; then clear_path "$dest" "$why"; fi
    mv "$tmp" "$dest"
    say "installed  $(tilde "$dest")  ($s @ $state)"
  fi

  # Switching prefix: drop the copy under the other name, but only one this setup made from this source.
  if [ -e "$other" ]; then
    if [ "$(marker_get "$other" source)" = "$src" ]; then
      clear_path "$other" "$(blocker "$other")"
      say "removed    $(tilde "$other") (now installed as $name)"
    else
      warn "$(tilde "$other") also exists and was not installed from here; Claude will see both. Left alone."
    fi
  fi

  # Shims for `bin` entries.
  while read -r kind bname script extra; do
    [ "$kind" = bin ] || continue
    [ -n "$script" ] && [ -z "$extra" ] || die "skills/$s/install.conf: bin needs exactly <name> <script>"
    [ -f "$dest/$script" ] || die "skills/$s/install.conf: bin $bname: no $script in the skill"
    shim="$BIN_DIR/$bname"
    # Any symlink is foreign: writing through one would create a file wherever it points.
    if [ -L "$shim" ] || { [ -e "$shim" ] && ! grep -qF "$SHIM_TAG" "$shim"; }; then
      clear_path "$shim" "$(tilde "$shim") exists and was not written by this setup"
    fi
    mkdir -p "$BIN_DIR"
    printf '#!/bin/sh\n%s from %s\nexec bun "%s" "$@"\n' "$SHIM_TAG" "$(tilde "$src")" "$dest/$script" > "$shim"
    chmod +x "$shim"
    say "shim       $(tilde "$shim") -> $(tilde "$dest/$script")"
    if command -v bun >/dev/null 2>&1 && ! "$shim" --help </dev/null >/dev/null 2>&1; then warn "$bname --help failed; try running $(tilde "$shim") --help"; fi
  done < <(conf "$s")
done

case ":$PATH:" in
  *":$BIN_DIR:"*) ;;
  *) warn "$(tilde "$BIN_DIR") is not on PATH, so the shims won't be found. fish: fish_add_path $(tilde "$BIN_DIR"); bash/zsh: export PATH=\"$(tilde "$BIN_DIR"):\$PATH\"" ;;
esac

# ---------------------------------------------------------------- report

need=0
for i in "${missing[@]}"; do
  if [ "${d_req[i]}" = 1 ]; then need=1; else say "optional, not installed: $(describe_dep "$i")"; fi
done
if [ $need = 0 ]; then
  say "done: ${#skills[@]} skill(s), every required command present"
  exit 0
fi

# Something required is still missing: hand it to Claude, with what it needs to know.
os=${PRETTY_NAME:-}
if [ "$KERNEL" = Darwin ]; then os="macOS $(sw_vers -productVersion 2>/dev/null || true)"; fi
cat <<EOF

The skills are installed, but some commands they need are missing.$([ $pm_ran = 1 ] && printf ' The package manager ran and they are still missing or too old; an older copy may come first on PATH.')
Paste this into Claude Code:

------------------------------------------------------------------------
Install the commands my Claude Code skills need on this machine.

Machine: ${os:-unknown OS} ($KERNEL $(uname -m))
Package manager setup found: ${mgr:-none it knows}
Skills repo: $(tilde "$REPO")

Missing or too old:
EOF
for i in "${missing[@]}"; do
  printf -- '- %s' "$(describe_dep "$i")"
  set -- ${d_arch[i]:+arch=${d_arch[i]}} ${d_brew[i]:+brew=${d_brew[i]}}
  if [ $# -gt 0 ]; then printf ' [package: %s]' "$*"; fi
  printf '\n'
done
cat <<EOF

Use this system's usual package manager, or the tool's official installer where
the package manager has no package or only an older version. Make sure each
command is on PATH for new shells and that \`<command> --version\` meets the
minimum. Then run $(tilde "$REPO")/setup again and confirm it ends with "done".
------------------------------------------------------------------------
EOF
exit 2
